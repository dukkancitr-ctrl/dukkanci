{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/delivery-quote.js": {
      "maxDuration": 10
    },
    "api/notify-order.js": {
      "maxDuration": 30
    },
    "api/campaign.js": {
      "maxDuration": 30
    },
    "api/ai.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/notify-order?action=subscription-cron", "schedule": "0 6 * * *" },
    { "path": "/api/ai?action=syn-cron", "schedule": "*/2 * * * *" }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "(?<host>.*\\.vercel\\.app)" }],
      "destination": "https://www.dukkanci.com.tr/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "dukkanci.com.tr" }],
      "destination": "https://www.dukkanci.com.tr/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/media/:path*", "destination": "https://tzcqnqzltrjemdnkzpzn.supabase.co/storage/v1/object/public/:path*" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/sitemap-stores.xml", "destination": "/api/sitemap?type=stores" },
    { "source": "/sitemap-products.xml", "destination": "/api/sitemap?type=products" },
    { "source": "/sitemap-categories.xml", "destination": "/api/sitemap?type=categories" },
    { "source": "/sitemap-pages.xml", "destination": "/api/sitemap?type=pages" },
    { "source": "/store/:id", "destination": "/api/store?id=:id" },
    { "source": "/product/:slug", "destination": "/api/product?slug=:slug" },
    { "source": "/category/:slug", "destination": "/api/category?slug=:slug" },
    { "source": "/why-dukkanci", "destination": "/api/why-dukkanci" },
    { "source": "/dalil", "destination": "/api/dalil" },
    { "source": "/dalil/compare", "destination": "/api/dalil?view=compare" },
    { "source": "/stores", "destination": "/api/stores" },
    { "source": "/offers", "destination": "/api/offers" },
    { "source": "/regions", "destination": "/api/regions" },
    { "source": "/contact", "destination": "/api/contact" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/gizlilik", "destination": "/privacy.html" },
    { "source": "/merchants", "destination": "/merchants.html" },
    { "source": "/features", "destination": "/features.html" },
    { "source": "/merchant-app", "destination": "/merchant-app.html" },
    { "source": "/app", "destination": "/customer-app.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(self), microphone=(self), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://maps.googleapis.com https://www.google.com https://www.gstatic.com https://www.googletagmanager.com https://connect.facebook.net https://analytics.tiktok.com https://cdn.jsdelivr.net; connect-src 'self' https://tzcqnqzltrjemdnkzpzn.supabase.co wss://tzcqnqzltrjemdnkzpzn.supabase.co https://maps.googleapis.com https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com https://www.googletagmanager.com https://connect.facebook.net https://www.facebook.com https://analytics.tiktok.com https://www.tiktok.com; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; frame-src 'self' https://www.google.com https://www.facebook.com https://www.youtube.com https://www.tiktok.com https://td.doubleclick.net; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" }
      ]
    },
    {
      "source": "/merchant",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/admin",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
